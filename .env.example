# Copy to `.env`. Leave everything blank to run the app on the built-in mock
# identifier — no backend required.

# --- Real AI identification (Vercel serverless function) ---
# Set this in your Vercel project's Environment Variables — NOT here, and NOT
# public (no EXPO_PUBLIC_ prefix). It's read server-side by api/identify.ts to
# call Claude. Use your normal Anthropic API key.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the identify endpoint (defaults to /api/identify on web).
# EXPO_PUBLIC_IDENTIFY_URL=

# --- Accounts (Supabase) ---
# Set BOTH to turn on real sign-in (email + password). Leave them blank and the
# app runs local-only with no account step — ideal for a quick demo. Find these
# in your Supabase project under Settings → API (Project URL + the anon/public
# key). On Vercel, add them as Environment Variables and redeploy.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only settings (Vercel Environment Variables; never EXPO_PUBLIC_) ---
# Scout's shared content, Scout's comments and the per-player daily limits need
# the Supabase SECRET key (it bypasses row-level security: server only).
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Protects the daily Scout job (api/crew-daily.ts). Any long random string.
# CRON_SECRET=

# Which Claude model does which job (defaults shown). See docs/AI_COSTS.md, and
# compare models on real photos with `npm run eval:identify` before changing
# the identifier.
# CLAUDE_MODEL_IDENTIFY=claude-opus-4-8      # names the animal in each photo
# CLAUDE_MODEL_TEXT=claude-opus-5-5          # Scout's facts, weekly themes, stories
# CLAUDE_MODEL_PHOTO_CHECK=claude-opus-5-5   # checks Wikimedia photos before use

# Per-player daily allowances (defaults shown). Counted in the database, so
# they need SUPABASE_SERVICE_ROLE_KEY and migration 0010.
# DAILY_IDENTIFY_LIMIT=300     # photos identified
# DAILY_GENERATE_LIMIT=60      # new Scout facts / stories written for a player
# DAILY_FLAG_LIMIT=20          # photos reported
