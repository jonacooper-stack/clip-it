{
  "buildCommand": "npx expo export -p web && node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/crew-daily",
      "schedule": "23 15 * * *"
    }
  ]
}
