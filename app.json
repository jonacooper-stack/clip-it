{
  "expo": {
    "name": "Clip-It",
    "slug": "clip-it",
    "scheme": "clipit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3EFE4",
    "newArchEnabled": true,
    "runtimeVersion": { "policy": "appVersion" },
    "assetBundlePatterns": ["**/*"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clipit.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clipit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13502E"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#13502E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Clip-It uses the camera so you can photograph the wildlife you spot."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clip-It tags each sighting with where you saw the animal. Your precise location stays private to you."
        }
      ],
      "expo-secure-store"
    ]
  }
}
